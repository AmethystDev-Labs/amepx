<%
  const CODE = it.CODE ?? it.code ?? "------";
  const CLIENTNAME = it.CLIENTNAME ?? it.clientName ?? "Unknown App";
  const CLIENTPICTURE = it.CLIENTPICTURE ?? it.clientPicture ?? "https://placehold.co/96x96/png";
  const CLIENT_DESCRIPTION =
    it.CLIENT_DESCRIPTION ?? it.CLIENTDESCRIPTION ?? it.clientDescription ?? "No description";
  const GROUP_ID = it.GROUP_ID ?? it.GROUPID ?? it.groupId ?? "000000";
  const REQUEST_ID = it.REQUEST_ID ?? it.requestId ?? "";
  const REDIRECT_URI = it.REDIRECT_URI ?? it.redirectUri ?? "";
  const STATE = it.STATE ?? it.state ?? "";
  const SCOPES = it.SCOPES ?? it.scopes ?? "";
%>
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Authorize Access</title>
    <style>
      :root {
        --bg: #e3e8f4;
        --text: #111a2f;
        --muted: #5d6c8c;
        --line: #bcc9e3;
        --surface: #f8fbff;
        --surface-soft: #edf3ff;
        --accent: #2a5ec8;
        --accent-2: #1d469e;
        --accent-ink: #ffffff;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        background:
          radial-gradient(980px 460px at 5% -5%, #ffffff 0%, transparent 62%),
          radial-gradient(980px 520px at 100% -18%, rgba(93, 128, 215, 0.22) 0%, transparent 64%),
          var(--bg);
        color: var(--text);
        font-family: "IBM Plex Sans", "Noto Sans SC", "PingFang SC", sans-serif;
        font-weight: 500;
      }

      .page {
        width: 100%;
        height: 100%;
      }

      .card {
        width: 100%;
        height: 100%;
        display: grid;
        grid-template-columns: minmax(340px, 40%) minmax(0, 1fr);
        background: rgba(248, 251, 255, 0.9);
      }

      .left-pane {
        min-width: 0;
        padding: clamp(18px, 2.3vw, 34px);
        border-right: 1px solid var(--line);
        background: linear-gradient(170deg, rgba(245, 249, 255, 0.96), rgba(232, 240, 255, 0.9));
        display: flex;
        flex-direction: column;
        gap: 16px;
        overflow-y: auto;
      }

      .app {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .avatar {
        width: 60px;
        height: 60px;
        border-radius: 15px;
        object-fit: cover;
        border: 1px solid #adbfeb;
        background: #eff4ff;
      }

      .name {
        margin: 0;
        font-size: clamp(26px, 3.1vw, 40px);
        line-height: 1.1;
        letter-spacing: 0.01em;
        font-weight: 700;
      }

      .desc {
        margin: 3px 0 0;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.55;
      }

      .block {
        border: 1px solid var(--line);
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.88);
        padding: 12px;
      }

      .block-title {
        margin: 0;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #3d4f7b;
      }

      .scope-grid {
        margin-top: 10px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
      }

      .scope-item {
        border: 1px solid var(--line);
        border-radius: 11px;
        background: var(--surface-soft);
        padding: 8px 9px;
      }

      .scope-name {
        margin: 0;
        font-size: 13px;
        font-weight: 700;
        color: #17233f;
      }

      .scope-desc {
        margin: 3px 0 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.5;
      }

      .context-list {
        margin-top: 10px;
        display: grid;
        gap: 8px;
      }

      .context-row {
        display: grid;
        grid-template-columns: 104px 1fr;
        gap: 8px;
        align-items: start;
      }

      .context-key {
        margin: 0;
        font-size: 12px;
        color: #3e4f79;
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }

      .context-value {
        margin: 0;
        font-size: 12px;
        line-height: 1.45;
        color: #253352;
        word-break: break-all;
      }

      .mono {
        font-family: "IBM Plex Mono", "SFMono-Regular", Menlo, Consolas, monospace;
      }

      .right-pane {
        min-width: 0;
        padding: clamp(18px, 2.7vw, 38px);
        display: flex;
        flex-direction: column;
        gap: 12px;
        overflow-y: auto;
        background: linear-gradient(180deg, rgba(252, 254, 255, 0.98), rgba(246, 250, 255, 0.94));
      }

      .headline {
        margin: 0;
        font-size: clamp(30px, 4.6vw, 56px);
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: 0.01em;
      }

      .subline {
        margin: 4px 0 0;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.6;
      }

      .subline code {
        font-family: "IBM Plex Mono", "SFMono-Regular", Menlo, Consolas, monospace;
        padding: 1px 5px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: #eef3ff;
        color: #294c95;
        font-size: 12px;
      }

      .code-box {
        border: 1px solid #abc0ee;
        border-radius: 16px;
        padding: 14px 12px;
        background: linear-gradient(160deg, #f4f8ff, #e9f0ff 70%);
      }

      .code-label {
        margin: 0 0 8px;
        color: #3e4f79;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .code {
        margin: 0;
        text-align: center;
        font-family: "IBM Plex Mono", "SFMono-Regular", Menlo, Consolas, monospace;
        letter-spacing: 0.2em;
        font-size: clamp(30px, 6.1vw, 88px);
        font-weight: 700;
      }

      .steps {
        margin: 2px 0 0;
        display: grid;
        gap: 8px;
      }

      .step {
        border: 1px solid var(--line);
        border-radius: 12px;
        background: #f9fbff;
        padding: 9px 10px;
        display: grid;
        grid-template-columns: 20px 1fr;
        gap: 8px;
        align-items: start;
      }

      .step-index {
        margin: 0;
        width: 20px;
        height: 20px;
        border-radius: 999px;
        display: grid;
        place-items: center;
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        background: linear-gradient(140deg, var(--accent), var(--accent-2));
      }

      .step-text {
        margin: 0;
        font-size: 13px;
        line-height: 1.55;
        color: #2b3b5d;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
      }

      .finish {
        border: 1px solid var(--accent-2);
        border-radius: 11px;
        padding: 10px 16px;
        font-size: 14px;
        font-weight: 700;
        color: var(--accent-ink);
        background: linear-gradient(140deg, var(--accent), var(--accent-2));
        cursor: pointer;
      }

      .finish:disabled {
        opacity: 0.62;
        cursor: not-allowed;
      }

      .status {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.5;
        flex: 1;
      }

      .note {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.6;
      }

      @media (max-width: 1080px) {
        .card {
          grid-template-columns: 1fr;
          height: auto;
          min-height: 100%;
        }

        .left-pane {
          border-right: 0;
          border-bottom: 1px solid var(--line);
        }
      }

      @media (max-width: 760px) {
        body {
          height: auto;
          min-height: 100%;
        }

        .page,
        .card {
          height: auto;
          min-height: 100vh;
        }

        .scope-grid {
          grid-template-columns: 1fr;
        }

        .context-row {
          grid-template-columns: 1fr;
          gap: 2px;
        }

        .headline {
          font-size: clamp(26px, 10vw, 42px);
        }
      }
    </style>
  </head>
  <body>
    <main
      class="page"
      data-request-id="<%= REQUEST_ID %>"
      data-redirect-uri="<%= REDIRECT_URI %>"
      data-state="<%= STATE %>"
      data-scopes="<%= SCOPES %>"
    >
      <section class="card">
        <aside class="left-pane">
          <div class="app">
            <img class="avatar" src="<%= CLIENTPICTURE %>" alt="<%= CLIENTNAME %> logo" />
            <div>
              <h1 class="name"><%= CLIENTNAME %></h1>
              <p class="desc"><%= CLIENT_DESCRIPTION %></p>
            </div>
          </div>

          <section class="block">
            <h2 class="block-title">Requested Scopes</h2>
            <div id="scope-grid" class="scope-grid"></div>
          </section>

          <section class="block">
            <h2 class="block-title">Authorization Context</h2>
            <div class="context-list">
              <div class="context-row">
                <p class="context-key">Group</p>
                <p class="context-value mono"><%= GROUP_ID %></p>
              </div>
              <div class="context-row">
                <p class="context-key">Request ID</p>
                <p class="context-value mono"><%= REQUEST_ID_DISPLAY %></p>
              </div>
              <div class="context-row">
                <p class="context-key">Redirect URI</p>
                <p class="context-value mono"><%= REDIRECT_URI_DISPLAY %></p>
              </div>
              <div class="context-row">
                <p class="context-key">State</p>
                <p class="context-value mono"><%= STATE_DISPLAY %></p>
              </div>
            </div>
          </section>
        </aside>

        <section class="right-pane">
          <h2 class="headline">完成 OneBot 群组验证</h2>
          <p class="subline">发送授权代码到指定群，验证成功后页面会自动跳转到回调地址并附带 <code>code</code> 与 <code>state</code>。</p>

          <div class="code-box">
            <p class="code-label">Authorization Code</p>
            <p class="code"><%= CODE %></p>
          </div>

          <section class="steps">
            <article class="step">
              <p class="step-index">1</p>
              <p class="step-text">
                将上面的授权代码发送到群 <span class="mono"><%= GROUP_ID %></span>。
              </p>
            </article>
            <article class="step">
              <p class="step-index">2</p>
              <p class="step-text">点击“完成并继续”，服务端将校验群历史中的授权消息。</p>
            </article>
            <article class="step">
              <p class="step-index">3</p>
              <p class="step-text">校验通过后自动跳转到客户端回调地址，完成 OAuth 授权流程。</p>
            </article>
          </section>

          <div class="actions">
            <button id="finish-btn" class="finish" type="button">完成并继续</button>
            <p id="status-text" class="status"></p>
          </div>

          <p class="note">若长时间未跳转，请确认你发送的代码与当前页面显示一致，并且应用回调地址配置正确。</p>
        </section>
      </section>
    </main>

    <script>
      (function () {
        const root = document.querySelector("main.page");
        const requestId = root.dataset.requestId || "";
        const redirectUriServer = root.dataset.redirectUri || "";
        const stateServer = root.dataset.state || "";
        const scopesServer = root.dataset.scopes || "";

        const query = new URL(window.location.href).searchParams;
        const redirectUri = query.get("redirect_uri") || redirectUriServer;
        const state = query.get("state") || stateServer;
        const scopeText = query.get("scope") || scopesServer;

        const finishBtn = document.getElementById("finish-btn");
        const statusText = document.getElementById("status-text");
        const scopeGrid = document.getElementById("scope-grid");

        const scopeMeta = {
          openid: {
            title: "openid",
            desc: "识别你的账号主体（sub），用于登录鉴权。",
          },
          profile: {
            title: "profile",
            desc: "读取昵称、头像等基础资料，用于展示个人信息。",
          },
          email: {
            title: "email",
            desc: "读取邮箱标识信息（当前映射为 QQ 邮箱形式）。",
          },
        };

        function esc(value) {
          return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#39;");
        }

        function parseScopes(source) {
          return String(source || "")
            .split(/\s+/)
            .map((item) => item.trim())
            .filter(Boolean);
        }

        function renderScopes(scopes) {
          if (!scopes.length) {
            scopeGrid.innerHTML = '<div class="scope-item"><p class="scope-name">basic</p><p class="scope-desc">读取基础身份信息。</p></div>';
            return;
          }

          scopeGrid.innerHTML = scopes
            .map((scope) => {
              const meta = scopeMeta[scope] || {
                title: scope,
                desc: "请求该应用定义的扩展权限。",
              };
              return `
                <article class="scope-item">
                  <p class="scope-name">${esc(meta.title)}</p>
                  <p class="scope-desc">${esc(meta.desc)}</p>
                </article>
              `;
            })
            .join("");
        }

        function setStatus(text, isError) {
          statusText.textContent = text || "";
          statusText.style.color = isError ? "#8a2432" : "#355082";
        }

        async function finish() {
          if (!requestId) {
            setStatus("request_id 缺失", true);
            return;
          }

          finishBtn.disabled = true;
          setStatus("正在校验群消息...");

          try {
            const response = await fetch("/api/onebot/check", {
              method: "POST",
              headers: {
                "content-type": "application/json",
              },
              body: JSON.stringify({ request_id: requestId }),
            });

            const data = await response.json();
            if (!response.ok) {
              setStatus(data.error_description || data.error || "校验失败", true);
              finishBtn.disabled = false;
              return;
            }

            if (!data.done) {
              setStatus(data.message || "未找到代码，请发送后重试", false);
              finishBtn.disabled = false;
              return;
            }

            const code = data.code;
            const finalState = data.state || state;
            if (redirectUri && code) {
              const callbackUrl = new URL(redirectUri);
              callbackUrl.searchParams.set("code", code);
              if (finalState) {
                callbackUrl.searchParams.set("state", finalState);
              }

              setStatus("校验成功，正在跳转...");
              window.location.replace(callbackUrl.toString());
              return;
            }

            setStatus(data.message || "已完成授权，但缺少跳转参数", false);
          } catch (error) {
            setStatus(String(error), true);
            finishBtn.disabled = false;
          }
        }

        renderScopes(parseScopes(scopeText));
        finishBtn.addEventListener("click", finish);
      })();
    </script>
  </body>
</html>
