<%
  const CODE = it.CODE ?? it.code ?? "------";
  const CLIENTNAME = it.CLIENTNAME ?? it.clientName ?? "Unknown App";
  const CLIENTPICTURE = it.CLIENTPICTURE ?? it.clientPicture ?? "https://placehold.co/96x96/png";
  const CLIENT_DESCRIPTION =
    it.CLIENT_DESCRIPTION ?? it.CLIENTDESCRIPTION ?? it.clientDescription ?? "No description";
  const GROUP_ID = it.GROUP_ID ?? it.GROUPID ?? it.groupId ?? "000000";
  const REQUEST_ID = it.REQUEST_ID ?? it.requestId ?? "";
  const REDIRECT_URI = it.REDIRECT_URI ?? it.redirectUri ?? "";
  const STATE = it.STATE ?? it.state ?? "";
  const SCOPES = it.SCOPES ?? it.scopes ?? "";
%>
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Authorize Access</title>
    <style>
      :root {
        --bg: #ebebeb;
        --surface: #ffffff;
        --surface-soft: #f2f2f2;
        --text: #111111;
        --muted: #616161;
        --line: #cccccc;
        --accent: #171717;
        --accent-ink: #ffffff;
        --page-gap: clamp(10px, 1.8vw, 22px);
        --page-max: 100%;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(980px 460px at 5% -5%, #ffffff 0%, transparent 62%),
          radial-gradient(980px 520px at 100% -18%, #d5d5d5 0%, transparent 64%),
          var(--bg);
        color: var(--text);
        font-family: "IBM Plex Sans", "Noto Sans SC", "PingFang SC", sans-serif;
        font-weight: 400;
        padding: var(--page-gap);
      }

      .page {
        width: 100%;
        max-width: var(--page-max);
        min-height: calc(100vh - (var(--page-gap) * 2));
        margin: 0 auto;
      }

      .card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 22px;
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.16);
        min-height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      .hero {
        padding: 22px 24px;
        border-bottom: 1px solid var(--line);
        background: linear-gradient(160deg, #ffffff, #f2f2f2 60%);
      }

      .app {
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .avatar {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        object-fit: cover;
        border: 1px solid #c8c8c8;
        background: #efefef;
      }

      .name {
        margin: 0;
        font-size: clamp(28px, 2.8vw, 38px);
        line-height: 1.2;
        letter-spacing: 0.01em;
        font-weight: 700;
      }

      .desc {
        margin: 3px 0 0;
        color: var(--muted);
        font-size: 15px;
      }

      .content {
        padding: 22px 24px 26px;
        flex: 1;
        display: flex;
        flex-direction: column;
      }

      .section-title {
        margin: 0 0 10px;
        font-size: 17px;
        font-weight: 700;
      }

      .scope-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 18px;
      }

      .scope-item {
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--surface-soft);
        padding: 10px;
      }

      .scope-name {
        margin: 0;
        font-size: 13px;
        font-weight: 700;
        color: #111111;
      }

      .scope-desc {
        margin: 4px 0 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.5;
      }

      .code-box {
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 18px 14px;
        background: #fafafa;
        margin: 4px 0 14px;
      }

      .code-label {
        margin: 0 0 8px;
        color: var(--muted);
        font-size: 13px;
      }

      .code {
        margin: 0;
        text-align: center;
        font-family: "IBM Plex Mono", "SFMono-Regular", Menlo, Consolas, monospace;
        letter-spacing: 0.22em;
        font-size: clamp(36px, 5.6vw, 78px);
        font-weight: 600;
      }

      .tip {
        margin: 0 0 16px;
        font-size: 14px;
        line-height: 1.7;
        color: #242424;
      }

      .group {
        font-family: "IBM Plex Mono", "SFMono-Regular", Menlo, Consolas, monospace;
        font-weight: 600;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        margin-top: auto;
      }

      .finish {
        border: 1px solid #000;
        border-radius: 12px;
        padding: 11px 20px;
        font-size: 15px;
        font-weight: 700;
        color: var(--accent-ink);
        background: linear-gradient(140deg, #373737, #101010);
        cursor: pointer;
      }

      .finish:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }

      .status {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
      }

      @media (max-width: 980px) {
        .scope-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 760px) {
        .scope-grid {
          grid-template-columns: 1fr;
        }

        .hero,
        .content {
          padding: 16px;
        }

        .name {
          font-size: 24px;
        }
      }
    </style>
  </head>
  <body>
    <main
      class="page"
      data-request-id="<%= REQUEST_ID %>"
      data-redirect-uri="<%= REDIRECT_URI %>"
      data-state="<%= STATE %>"
      data-scopes="<%= SCOPES %>"
    >
      <section class="card">
        <header class="hero">
          <div class="app">
            <img class="avatar" src="<%= CLIENTPICTURE %>" alt="<%= CLIENTNAME %> logo" />
            <div>
              <h1 class="name"><%= CLIENTNAME %></h1>
              <p class="desc"><%= CLIENT_DESCRIPTION %></p>
            </div>
          </div>
        </header>

        <div class="content">
          <h2 class="section-title">该应用将请求以下权限</h2>
          <div id="scope-grid" class="scope-grid"></div>

          <div class="code-box">
            <p class="code-label">授权代码</p>
            <p class="code"><%= CODE %></p>
          </div>

          <p class="tip">
            请将上方代码发送到群 <span class="group"><%= GROUP_ID %></span>，完成后点击下方按钮继续。
          </p>

          <div class="actions">
            <button id="finish-btn" class="finish" type="button">完成并继续</button>
            <p id="status-text" class="status"></p>
          </div>
        </div>
      </section>
    </main>

    <script>
      (function () {
        const root = document.querySelector("main.page");
        const requestId = root.dataset.requestId || "";
        const redirectUriServer = root.dataset.redirectUri || "";
        const stateServer = root.dataset.state || "";
        const scopesServer = root.dataset.scopes || "";

        const query = new URL(window.location.href).searchParams;
        const redirectUri = query.get("redirect_uri") || redirectUriServer;
        const state = query.get("state") || stateServer;
        const scopeText = query.get("scope") || scopesServer;

        const finishBtn = document.getElementById("finish-btn");
        const statusText = document.getElementById("status-text");
        const scopeGrid = document.getElementById("scope-grid");

        const scopeMeta = {
          openid: {
            title: "openid",
            desc: "识别你的账号主体（sub），用于登录鉴权。",
          },
          profile: {
            title: "profile",
            desc: "读取昵称、头像等基础资料，用于展示个人信息。",
          },
          email: {
            title: "email",
            desc: "读取邮箱标识信息（当前映射为 QQ 邮箱形式）。",
          },
        };

        function esc(value) {
          return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#39;");
        }

        function parseScopes(source) {
          return String(source || "")
            .split(/\s+/)
            .map((item) => item.trim())
            .filter(Boolean);
        }

        function renderScopes(scopes) {
          if (!scopes.length) {
            scopeGrid.innerHTML = '<div class="scope-item"><p class="scope-name">basic</p><p class="scope-desc">读取基础身份信息。</p></div>';
            return;
          }

          scopeGrid.innerHTML = scopes
            .map((scope) => {
              const meta = scopeMeta[scope] || {
                title: scope,
                desc: "请求该应用定义的扩展权限。",
              };
              return `
                <article class="scope-item">
                  <p class="scope-name">${esc(meta.title)}</p>
                  <p class="scope-desc">${esc(meta.desc)}</p>
                </article>
              `;
            })
            .join("");
        }

        function setStatus(text, isError) {
          statusText.textContent = text || "";
          statusText.style.color = isError ? "#000000" : "#666666";
        }

        async function finish() {
          if (!requestId) {
            setStatus("request_id 缺失", true);
            return;
          }

          finishBtn.disabled = true;
          setStatus("正在校验群消息...");

          try {
            const response = await fetch("/api/onebot/check", {
              method: "POST",
              headers: {
                "content-type": "application/json",
              },
              body: JSON.stringify({ request_id: requestId }),
            });

            const data = await response.json();
            if (!response.ok) {
              setStatus(data.error_description || data.error || "校验失败", true);
              finishBtn.disabled = false;
              return;
            }

            if (!data.done) {
              setStatus(data.message || "未找到代码，请发送后重试", false);
              finishBtn.disabled = false;
              return;
            }

            const code = data.code;
            const finalState = data.state || state;
            if (redirectUri && code) {
              const callbackUrl = new URL(redirectUri);
              callbackUrl.searchParams.set("code", code);
              if (finalState) {
                callbackUrl.searchParams.set("state", finalState);
              }

              setStatus("校验成功，正在跳转...");
              window.location.replace(callbackUrl.toString());
              return;
            }

            setStatus(data.message || "已完成授权，但缺少跳转参数", false);
          } catch (error) {
            setStatus(String(error), true);
            finishBtn.disabled = false;
          }
        }

        renderScopes(parseScopes(scopeText));
        finishBtn.addEventListener("click", finish);
      })();
    </script>
  </body>
</html>
