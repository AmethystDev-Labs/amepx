<%
  const CODE = it.CODE ?? it.code ?? "------";
  const CLIENTNAME = it.CLIENTNAME ?? it.clientName ?? "Unknown App";
  const CLIENTPICTURE = it.CLIENTPICTURE ?? it.clientPicture ?? "https://placehold.co/96x96/png";
  const CLIENT_DESCRIPTION =
    it.CLIENT_DESCRIPTION ?? it.CLIENTDESCRIPTION ?? it.clientDescription ?? "No description";
  const GROUP_ID = it.GROUP_ID ?? it.GROUPID ?? it.groupId ?? "000000";
  const REQUEST_ID = it.REQUEST_ID ?? it.requestId ?? "";
  const REDIRECT_URI = it.REDIRECT_URI ?? it.redirectUri ?? "";
  const STATE = it.STATE ?? it.state ?? "";
  const SCOPES = it.SCOPES ?? it.scopes ?? "";
%>
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Authorize Access</title>
    <style>
      :root {
        --bg: #e3e8f4;
        --surface: rgba(251, 253, 255, 0.94);
        --surface-soft: #eef3ff;
        --text: #131c31;
        --muted: #5b6987;
        --line: #bcc9e3;
        --accent: #2a5ec8;
        --accent-2: #1d469e;
        --danger: #8a2432;
        --page-pad: clamp(10px, 1.6vw, 18px);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100%;
      }

      body {
        min-height: 100vh;
        background:
          radial-gradient(980px 460px at 5% -5%, #ffffff 0%, transparent 62%),
          radial-gradient(980px 520px at 100% -18%, rgba(93, 128, 215, 0.2) 0%, transparent 64%),
          var(--bg);
        color: var(--text);
        font-family: "IBM Plex Sans", "Noto Sans SC", "PingFang SC", sans-serif;
        font-weight: 500;
        padding: var(--page-pad);
        display: grid;
        place-items: center;
      }

      .page {
        width: min(920px, 100%);
        height: calc(100vh - (var(--page-pad) * 2));
        max-height: calc(100vh - (var(--page-pad) * 2));
      }

      .card {
        border: 1px solid var(--line);
        border-radius: 20px;
        background: var(--surface);
        box-shadow:
          0 18px 36px rgba(29, 60, 124, 0.16),
          inset 0 0 0 1px rgba(255, 255, 255, 0.5);
        display: flex;
        flex-direction: column;
        height: 100%;
        max-height: 100%;
        min-height: 0;
        overflow: hidden;
      }

      .top {
        padding: 14px 16px;
        border-bottom: 1px solid var(--line);
        background: linear-gradient(165deg, rgba(255, 255, 255, 0.95), rgba(236, 244, 255, 0.9));
      }

      .app {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .avatar {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        object-fit: cover;
        border: 1px solid #abc0ee;
        background: var(--surface-soft);
      }

      .name {
        margin: 0;
        font-size: clamp(22px, 3.2vw, 30px);
        line-height: 1.15;
        font-weight: 700;
      }

      .desc {
        margin: 3px 0 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.55;
      }

      .lead {
        margin: 8px 0 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.55;
      }

      .main {
        padding: 12px;
        display: grid;
        gap: 8px;
        flex: 1;
        min-height: 0;
        overflow: auto;
        overscroll-behavior: contain;
      }

      .block {
        border: 1px solid var(--line);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.86);
        padding: 10px 11px;
      }

      .block-title {
        margin: 0;
        font-size: 12px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        font-weight: 700;
        color: #3f5078;
      }

      .code-box {
        margin-top: 8px;
        border: 1px solid #adc2ef;
        border-radius: 12px;
        background: linear-gradient(160deg, #f3f8ff, #e8efff 72%);
        padding: 10px;
      }

      .code {
        margin: 0;
        text-align: center;
        font-family: "IBM Plex Mono", "SFMono-Regular", Menlo, Consolas, monospace;
        font-size: clamp(30px, 6vw, 54px);
        letter-spacing: 0.16em;
        font-weight: 700;
        line-height: 1.15;
      }

      .tip {
        margin: 8px 0 0;
        color: #2d3d61;
        font-size: 13px;
        line-height: 1.55;
      }

      .mono {
        font-family: "IBM Plex Mono", "SFMono-Regular", Menlo, Consolas, monospace;
      }

      .scope-grid {
        margin-top: 8px;
        display: flex;
        flex-wrap: nowrap;
        gap: 8px;
        overflow-x: auto;
        overflow-y: hidden;
        padding-bottom: 2px;
      }

      .scope-item {
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--surface-soft);
        padding: 8px;
        min-width: 260px;
        flex: 1 0 260px;
      }

      .scope-name {
        margin: 0;
        font-size: 12px;
        font-weight: 700;
        color: #192645;
      }

      .scope-desc {
        margin: 3px 0 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.5;
      }

      .context-list {
        margin-top: 8px;
        display: grid;
        gap: 6px;
      }

      .context-row {
        display: grid;
        grid-template-columns: 106px 1fr;
        gap: 8px;
      }

      .context-key {
        margin: 0;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #4a5b84;
      }

      .context-value {
        margin: 0;
        font-size: 12px;
        line-height: 1.45;
        color: #2b3a5c;
        word-break: break-all;
      }

      .steps {
        margin: 8px 0 0;
        padding-left: 18px;
        display: grid;
        gap: 6px;
      }

      .steps li {
        color: #2d3f66;
        font-size: 12px;
        line-height: 1.52;
      }

      .actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }

      .finish {
        border: 1px solid var(--accent-2);
        border-radius: 10px;
        padding: 8px 14px;
        font-size: 13px;
        font-weight: 700;
        color: #fff;
        background: linear-gradient(140deg, var(--accent), var(--accent-2));
        cursor: pointer;
      }

      .finish:disabled {
        opacity: 0.62;
        cursor: not-allowed;
      }

      .status {
        margin: 0;
        min-height: 1.3em;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.45;
      }

      .note {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.55;
      }

      @media (max-width: 720px) {
        body {
          padding: 8px;
        }

        .top,
        .main {
          padding: 10px;
        }

        .context-row {
          grid-template-columns: 1fr;
          gap: 2px;
        }
      }
    </style>
  </head>
  <body>
    <main
      class="page"
      data-request-id="<%= REQUEST_ID %>"
      data-redirect-uri="<%= REDIRECT_URI %>"
      data-state="<%= STATE %>"
      data-scopes="<%= SCOPES %>"
    >
      <section class="card">
        <header class="top">
          <div class="app">
            <img class="avatar" src="<%= CLIENTPICTURE %>" alt="<%= CLIENTNAME %> logo" />
            <div>
              <h1 class="name"><%= CLIENTNAME %></h1>
              <p class="desc"><%= CLIENT_DESCRIPTION %></p>
            </div>
          </div>
          <p class="lead">该应用正在请求授权。完成下方 OneBot 验证后，将跳转回客户端回调地址继续流程。</p>
        </header>

        <section class="main">
          <section class="block">
            <h2 class="block-title">Authorization Code</h2>
            <div class="code-box">
              <p class="code"><%= CODE %></p>
            </div>
            <p class="tip">请将上面的授权代码发送到群 <span class="mono"><%= GROUP_ID %></span>，然后点击“完成并继续”。</p>
          </section>

          <section class="block">
            <h2 class="block-title">Requested Scopes</h2>
            <div id="scope-grid" class="scope-grid"></div>
          </section>

          <section class="block">
            <h2 class="block-title">Authorization Context</h2>
            <div class="context-list">
              <div class="context-row">
                <p class="context-key">Group</p>
                <p class="context-value mono"><%= GROUP_ID %></p>
              </div>
              <div class="context-row">
                <p class="context-key">Request ID</p>
                <p class="context-value mono"><%= REQUEST_ID_DISPLAY %></p>
              </div>
              <div class="context-row">
                <p class="context-key">Redirect URI</p>
                <p class="context-value mono"><%= REDIRECT_URI_DISPLAY %></p>
              </div>
              <div class="context-row">
                <p class="context-key">State</p>
                <p class="context-value mono"><%= STATE_DISPLAY %></p>
              </div>
              <div class="context-row">
                <p class="context-key">Scope</p>
                <p class="context-value mono"><%= SCOPES_DISPLAY %></p>
              </div>
            </div>
          </section>

          <section class="block">
            <h2 class="block-title">验证流程</h2>
            <ol class="steps">
              <li>在目标群内发送本页显示的授权代码。</li>
              <li>点击下方“完成并继续”触发服务器校验。</li>
              <li>校验通过后将自动重定向到客户端回调地址，携带 <span class="mono">code</span> 与 <span class="mono">state</span>。</li>
            </ol>
          </section>

          <div class="actions">
            <button id="finish-btn" class="finish" type="button">完成并继续</button>
            <p id="status-text" class="status"></p>
          </div>

          <p class="note">如果未跳转，请确认群消息中确实发送了当前页面授权码，并检查客户端回调地址配置。</p>
        </section>
      </section>
    </main>

    <script>
      (function () {
        const root = document.querySelector("main.page");
        const requestId = root.dataset.requestId || "";
        const redirectUriServer = root.dataset.redirectUri || "";
        const stateServer = root.dataset.state || "";
        const scopesServer = root.dataset.scopes || "";

        const query = new URL(window.location.href).searchParams;
        const redirectUri = query.get("redirect_uri") || redirectUriServer;
        const state = query.get("state") || stateServer;
        const scopeText = query.get("scope") || scopesServer;

        const finishBtn = document.getElementById("finish-btn");
        const statusText = document.getElementById("status-text");
        const scopeGrid = document.getElementById("scope-grid");

        const scopeMeta = {
          openid: {
            title: "openid",
            desc: "识别你的账号主体（sub），用于登录鉴权。",
          },
          profile: {
            title: "profile",
            desc: "读取昵称、头像等基础资料，用于展示个人信息。",
          },
          email: {
            title: "email",
            desc: "读取邮箱标识信息（当前映射为 QQ 邮箱形式）。",
          },
        };

        function esc(value) {
          return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#39;");
        }

        function parseScopes(source) {
          return String(source || "")
            .split(/\s+/)
            .map((item) => item.trim())
            .filter(Boolean);
        }

        function renderScopes(scopes) {
          if (!scopes.length) {
            scopeGrid.innerHTML = '<div class="scope-item"><p class="scope-name">basic</p><p class="scope-desc">读取基础身份信息。</p></div>';
            return;
          }

          scopeGrid.innerHTML = scopes
            .map((scope) => {
              const meta = scopeMeta[scope] || {
                title: scope,
                desc: "请求该应用定义的扩展权限。",
              };
              return `
                <article class="scope-item">
                  <p class="scope-name">${esc(meta.title)}</p>
                  <p class="scope-desc">${esc(meta.desc)}</p>
                </article>
              `;
            })
            .join("");
        }

        function setStatus(text, isError) {
          statusText.textContent = text || "";
          statusText.style.color = isError ? "var(--danger)" : "#355082";
        }

        async function finish() {
          if (!requestId) {
            setStatus("request_id 缺失", true);
            return;
          }

          finishBtn.disabled = true;
          setStatus("正在校验群消息...");

          try {
            const response = await fetch("/api/onebot/check", {
              method: "POST",
              headers: {
                "content-type": "application/json",
              },
              body: JSON.stringify({ request_id: requestId }),
            });

            const data = await response.json();
            if (!response.ok) {
              setStatus(data.error_description || data.error || "校验失败", true);
              finishBtn.disabled = false;
              return;
            }

            if (!data.done) {
              setStatus(data.message || "未找到代码，请发送后重试", false);
              finishBtn.disabled = false;
              return;
            }

            const code = data.code;
            const finalState = data.state || state;
            if (redirectUri && code) {
              const callbackUrl = new URL(redirectUri);
              callbackUrl.searchParams.set("code", code);
              if (finalState) {
                callbackUrl.searchParams.set("state", finalState);
              }

              setStatus("校验成功，正在跳转...");
              window.location.replace(callbackUrl.toString());
              return;
            }

            setStatus(data.message || "已完成授权，但缺少跳转参数", false);
          } catch (error) {
            setStatus(String(error), true);
            finishBtn.disabled = false;
          }
        }

        renderScopes(parseScopes(scopeText));
        finishBtn.addEventListener("click", finish);
      })();
    </script>
  </body>
</html>
